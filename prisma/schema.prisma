// Prisma schema for the profile backend.
//
// Every model, field and nullability decision here is derived from the existing Angular
// project's interfaces (src/app/core/models/*.model.ts) and static data
// (public/assets/data/*.json). See docs/MIGRATION-MAPPING.md for the field-by-field
// justification, including the three deliberate additions (sortOrder, isPublished, skills).
//
// Conventions:
//   - @@map / @map give the tables and columns the snake_case names used by the existing
//     domain vocabulary (person, exp_responsibility, proj_technology, ...).
//   - legacyId preserves the original string ids ("exp1", "proj14") that the frontend
//     already uses for tracking and for #project-<id> deep links.
//   - Date-like fields are String because the source data is human-formatted free text at
//     inconsistent precision ("Jan 2024", "2025", "June 26"). See MIGRATION-MAPPING §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. On Supabase this is the TRANSACTION pooler (port 6543), which
  // suits short-lived serverless/container connections.
  url       = env("DATABASE_URL")
  // Migrations and introspection need a direct session connection: PgBouncer in
  // transaction mode cannot run the advisory locks and prepared statements Prisma Migrate
  // relies on. On Supabase this is the SESSION pooler / direct connection (port 5432).
  // For a plain local Postgres, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// SaaS platform enums
// ---------------------------------------------------------------------------

/// Platform-wide role. Resolved from User.role on every request during JWT validation -
/// never trusted from a client-supplied value. See docs/SAAS-ARCHITECTURE.md.
enum Role {
  ADMIN
  COORDINATOR
  CLIENT

  @@map("role")
}

enum UserStatus {
  active
  suspended

  @@map("user_status")
}

/// Tenant lifecycle. Transitions are validated by TenantLifecycleService, not by callers
/// setting the field directly - see that service for the allowed transition graph.
enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  SUSPENDED
  CANCELLED

  @@map("subscription_status")
}

enum BillingInterval {
  MONTHLY
  YEARLY

  @@map("billing_interval")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

/// Workflow state for a marketing-site "contact us" submission. Set by an ADMIN or
/// COORDINATOR reviewing the inbox - never by the submitter.
enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM

  @@map("contact_submission_status")
}

/// Whether Person.avatar points at the platform's built-in default SVG or a file the client
/// uploaded through StorageService. See docs/SAAS-ARCHITECTURE.md.
enum AvatarSource {
  DEFAULT
  CUSTOM

  @@map("avatar_source")
}

// ---------------------------------------------------------------------------
// Existing profile-domain enums
// ---------------------------------------------------------------------------

/// Values observed in achievements.json: award (3), certification (1), recognition (6).
/// `milestone` is declared by the frontend interface but unused in data; kept so the admin
/// portal can use it without a migration.
enum AchievementCategory {
  award
  certification
  recognition
  milestone

  @@map("achievement_category")
}

/// Values observed in timeline.json: work (7), achievement (6), education (5).
/// `project` and `certification` are declared by the frontend interface but unused in data.
enum TimelineEventType {
  work
  education
  achievement
  project
  certification

  @@map("timeline_event_type")
}

/// The frontend interface declares 'high' | 'low', but management.json actually contains
/// high (2) and medium (1) - and the component filters for 'low', so the medium row renders
/// nowhere today. All three are modelled; see MIGRATION-MAPPING §5.4.
enum ManagementLevel {
  high
  medium
  low

  @@map("management_level")
}

// ---------------------------------------------------------------------------
// SaaS platform - Tenant, User, RBAC, billing, audit
//
// A Tenant is the account. It owns exactly one Person (the existing profile domain,
// unmodified below) plus its own theme and website settings. Tenant.id is an internal
// UUID used for every relation; Tenant.slug is the public, human-readable identifier used
// in URLs and is NEVER used for authorization - see docs/SAAS-ARCHITECTURE.md.
// ---------------------------------------------------------------------------

model Tenant {
  /// Internal identity. Never derived from or equal to the slug, and never re-used.
  id String @id @default(uuid())

  /// Public identity. Looked up case-insensitively (stored lower-cased) for the public
  /// profile route and API. Changing it does not change `id`, and does not affect any
  /// existing authorization check - every protected query still keys off `id`.
  slug String @unique

  name   String
  status TenantStatus @default(PENDING)

  /// The client's own "is my profile live" switch - distinct from `status`, which an admin
  /// controls. Both must allow public access; see TenantAccessService.isPubliclyAccessible.
  isPublished Boolean @default(true) @map("is_published")

  /// Platform user who ran the creation - an Admin, or a Coordinator creating on their own
  /// behalf. Nullable so a data-migration-created tenant (see prisma/seed.ts) is not forced
  /// to reference a synthetic actor.
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Coordinator currently assigned to this tenant, if any. Nullable and reassignable by an
  /// Admin. A Coordinator's "assigned tenants" list is exactly the tenants pointing back at
  /// them here - there is no separate membership table because one tenant needs at most one
  /// assigned coordinator for this platform's size; see docs/SAAS-ARCHITECTURE.md for the
  /// trade-off and how to evolve it into a join table without touching callers.
  coordinatorId String? @map("coordinator_id")
  coordinator   User?   @relation("TenantCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  person       Person?
  theme        TenantTheme?
  settings     WebsiteSettings?
  sections     ClientSection[]
  client       User?
  subscription Subscription?
  payments     Payment[]
  slugHistory  TenantSlugHistory[]
  auditLogs    AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([coordinatorId])
  @@index([createdById])
  @@map("tenant")
}

/// Retired slugs. Consulted by the public lookup when a slug does not match any live
/// Tenant, so a previously shared profile URL degrades to "moved" info instead of a plain
/// 404 - see PublicProfileService.resolveTenant. Uniqueness here (not just on the live
/// Tenant.slug) stops a new tenant from squatting a slug someone else's old links still
/// point at.
model TenantSlugHistory {
  id String @id @default(cuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slug String @unique

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_slug_history")
}

/// Every platform account: the SaaS owner (ADMIN), an operator managing a subset of
/// tenants (COORDINATOR), or the person who owns one tenant's content (CLIENT).
///
/// tenantId is set only for CLIENT and is unique, giving the 1:1 "a client manages exactly
/// one tenant" relationship the spec calls for. ADMIN and COORDINATOR always have
/// tenantId = null - a Coordinator's tenants are found via Tenant.coordinatorId, not here.
model User {
  id String @id @default(cuid())

  email        String     @unique
  /// Argon2id hash. Never selected into a response DTO.
  passwordHash String     @map("password_hash")
  name         String?
  role         Role
  status       UserStatus @default(active)

  tenantId String? @unique @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  coordinatedTenants Tenant[] @relation("TenantCoordinator")
  createdTenants     Tenant[] @relation("TenantCreatedBy")

  resolvedContactSubmissions ContactSubmission[] @relation("ContactSubmissionResolvedBy")

  /// Control Portal theme preference - independent of TenantTheme, which is the PUBLIC
  /// WEBSITE's own theme. See PreferencesService.
  preference UserPreference?

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([tenantId])
  @@map("user")
}

/// One row per tenant, mutated in place as the plan changes or a period renews. Payment
/// rows are the historical trail; this row is always "the current state."
model Subscription {
  id String @id @default(cuid())

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(TRIAL)

  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  renewalDate DateTime? @map("renewal_date")
  autoRenew   Boolean   @default(false) @map("auto_renew")

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([renewalDate])
  @@map("subscription")
}

model Plan {
  id String @id @default(cuid())

  name            String          @unique
  description     String?
  /// Smallest-currency-unit-free decimal amount, e.g. 29.00. Never a float.
  price           Decimal         @db.Decimal(10, 2)
  currency        String          @default("USD")
  billingInterval BillingInterval @map("billing_interval")
  active          Boolean         @default(true)
  /// Free-form list of feature flags/labels shown on a pricing page. Not machine-enforced -
  /// see docs/SAAS-ARCHITECTURE.md for why gating logic must not read this field.
  features        Json            @default("[]")

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plan")
}

/// Provider-agnostic payment record. `provider` is "manual" until a real processor
/// (Stripe, ...) is integrated; that integration only ever needs to add rows here and flip
/// Subscription.status via a webhook handler, never touch the tenant/profile domain.
model Payment {
  id String @id @default(cuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("USD")
  status   PaymentStatus @default(PENDING)

  provider              String
  providerTransactionId String? @map("provider_transaction_id")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payment")
}

/// Append-only. Never updated or deleted by application code, and never carries a
/// password, token, or secret - see AuditLogService.
model AuditLog {
  id String @id @default(cuid())

  /// Nullable: a system-initiated action (e.g. an automated subscription expiry) has no
  /// human actor.
  actorId   String? @map("actor_id")
  /// Snapshot of the actor's role at the time of the action - roles can change later, and
  /// the log should reflect what was true when the action happened, not now.
  actorRole String? @map("actor_role")

  /// Nullable: platform-level actions (creating a coordinator, for instance) have no tenant.
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  action     String
  resource   String
  resourceId String? @map("resource_id")
  /// Small, structured, non-sensitive context (e.g. { "from": "ACTIVE", "to": "SUSPENDED" }).
  metadata   Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

/// A "contact us" submission from the Portfolio marketing site (the platform's own /contact
/// page) - not a tenant's public profile contact info, which is the unrelated Contact model.
/// Platform-level rather than tenant-scoped: it is an inquiry directed at Portfolio itself,
/// so it deliberately carries no tenantId.
model ContactSubmission {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  company String?
  subject String
  message String

  status ContactSubmissionStatus @default(NEW)

  /// Recorded for spam triage only - never shown to the submitter, never exposed publicly.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  resolvedById String?   @map("resolved_by_id")
  resolvedBy   User?     @relation("ContactSubmissionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_submission")
}

/// Visual configuration, one row per tenant. Colors are validated as hex strings at the DTO
/// layer; `customCss` is optional and, if present, is emitted inside a scoped <style> tag by
/// the frontend rather than evaluated - it can change appearance but cannot run script. See
/// docs/SAAS-ARCHITECTURE.md "Theme security" for the full threat model and size limit.
model TenantTheme {
  id String @id @default(cuid())

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  primaryColor    String  @default("#6366f1") @map("primary_color")
  secondaryColor  String  @default("#64748b") @map("secondary_color")
  accentColor     String  @default("#06b6d4") @map("accent_color")
  backgroundColor String  @default("#ffffff") @map("background_color")
  textColor       String  @default("#334155") @map("text_color")
  headingColor    String  @default("#0f172a") @map("heading_color")
  fontFamily      String  @default("Inter, sans-serif") @map("font_family")
  /// CSS length, e.g. "0.5rem". Free-form rather than an enum: the frontend clamps it to a
  /// sane range rather than the API rejecting values a future layout might want.
  borderRadius    String  @default("0.5rem") @map("border_radius")
  layout          String  @default("classic")
  /// Validated against DESIGN_SYSTEMS in design-registry.ts, not a DB enum - see
  /// docs/SAAS-ARCHITECTURE.md.
  designSystem    String  @default("modern") @map("design_system")
  /// Validated against THEME_MODES in theme-mode-registry.ts, not a DB enum - a future
  /// 'system' value must never need a migration. Applies to background/text/heading only
  /// when 'light'; 'dark' uses the frontend's fixed dark tokens instead - see
  /// docs/SAAS-ARCHITECTURE.md.
  themeMode       String  @default("light") @map("theme_mode")
  customCss       String? @map("custom_css") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_theme")
}

/// One row per user's Control Portal preference - independent of TenantTheme, which is the
/// PUBLIC WEBSITE's theme. Keyed by userId, not tenantId: ADMIN/COORDINATOR have no tenantId
/// but are still real authenticated users of this same portal chrome. Lazily upserted by
/// PreferencesService, not seeded during onboarding - most users have no row until they
/// explicitly change something away from the default.
model UserPreference {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Validated against THEME_MODES in theme-mode-registry.ts, not a DB enum.
  themeMode String @default("light") @map("theme_mode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preference")
}

/// Site-level configuration, distinct from profile content (Person/Experience/...) and
/// from Contact.socialLinks, which remains the one place social links live.
model WebsiteSettings {
  id String @id @default(cuid())

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  websiteTitle String  @map("website_title")
  description  String? @db.Text
  faviconUrl   String? @map("favicon_url")
  logoUrl      String? @map("logo_url")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_settings")
}

/// Which profile sections a tenant shows publicly, and in what order - see
/// section-registry.ts for the fixed set of valid `sectionKey`s. Deliberately its own table
/// rather than array columns on WebsiteSettings: per-section timestamps, and a
/// straightforward single-row PATCH for one section's `enabled` flag or a transactional bulk
/// reorder, are both awkward to express against a string array.
model ClientSection {
  id String @id @default(cuid())

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sectionKey   String  @map("section_key")
  enabled      Boolean @default(true)
  displayOrder Int     @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, sectionKey])
  @@index([tenantId, displayOrder])
  @@map("client_section")
}

// ---------------------------------------------------------------------------
// Person - the existing profile domain, unmodified except for how its tenant boundary is
// expressed: it now belongs to a Tenant instead of being one.
// ---------------------------------------------------------------------------

/// A Person is one tenant's profile content. Every child table below still carries
/// personId exactly as before migration, and every admin query is still scoped by it -
/// that scoping code is untouched. What changed is only how the current caller's personId
/// is resolved: through their Tenant now, rather than Person being the tenant itself.
/// See docs/SAAS-ARCHITECTURE.md "Why personId scoping did not need to change".
model Person {
  id String @id @default(cuid())

  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  title             String
  summary           String  @db.Text
  location          String
  yearsOfExperience Int     @map("years_of_experience")
  avatar            String
  /// Whether `avatar` is the platform's built-in default SVG or something the client
  /// uploaded - see StorageService and AvatarController. Never omit an avatar entirely.
  avatarSource      AvatarSource @default(DEFAULT) @map("avatar_source")
  avatarUpdatedAt   DateTime?    @map("avatar_updated_at")
  /// StorageService key for the current CUSTOM avatar file, so it can be deleted on
  /// replacement/removal. Null when avatarSource is DEFAULT, or for a CUSTOM avatar that
  /// predates this feature (a legacy path string StorageService never uploaded). Never
  /// exposed in any response DTO - purely internal bookkeeping.
  avatarStorageKey  String?      @map("avatar_storage_key")
  tagline           String
  linkedin          String?
  birthday          String?

  contact         Contact?
  technologies    Technology[]
  experiences     Experience[]
  projects        Project[]
  achievements    Achievement[]
  courses         Course[]
  timelineEvents  TimelineEvent[]
  managementRoles ManagementRole[]
  skillCategories SkillCategory[]
  cvVersions      CvVersion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("person")
}

// ---------------------------------------------------------------------------
// Contact - 1:1 with person
// ---------------------------------------------------------------------------

model Contact {
  id String @id @default(cuid())

  personId String @unique @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  email      String
  phone      String
  whatsapp   String
  linkedin   String
  location   String?
  birthday   String?
  muchskills String?

  socialLinks ContactSocialLink[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact")
}

model ContactSocialLink {
  id String @id @default(cuid())

  contactId String  @map("contact_id")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  platform  String
  url       String
  icon      String?
  sortOrder Int     @map("sort_order")

  @@index([contactId, sortOrder])
  @@map("contact_social_link")
}

// ---------------------------------------------------------------------------
// Experience
// ---------------------------------------------------------------------------

model Experience {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  company            String
  companyFullName    String? @map("company_full_name")
  companyLogo        String? @map("company_logo")
  companyWebsite     String? @map("company_website")
  companyDescription String? @map("company_description") @db.Text
  position           String
  location           String
  startDate          String  @map("start_date")
  endDate            String? @map("end_date")
  isCurrent          Boolean @map("is_current")
  description        String  @db.Text

  responsibilities ExperienceResponsibility[]
  achievements     ExperienceAchievement[]
  technologies     ExperienceTechnology[]

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("experience")
}

model ExperienceResponsibility {
  id String @id @default(cuid())

  experienceId String     @map("experience_id")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  description String @db.Text
  sortOrder   Int    @map("sort_order")

  @@index([experienceId, sortOrder])
  @@map("exp_responsibility")
}

model ExperienceAchievement {
  id String @id @default(cuid())

  experienceId String     @map("experience_id")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  description String @db.Text
  sortOrder   Int    @map("sort_order")

  @@index([experienceId, sortOrder])
  @@map("exp_achievement")
}

/// Junction: experience <-> technology (many-to-many).
model ExperienceTechnology {
  experienceId String     @map("experience_id")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  technologyId String     @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  sortOrder Int @map("sort_order")

  @@id([experienceId, technologyId])
  @@index([experienceId, sortOrder])
  @@index([technologyId])
  @@map("exp_technology")
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  name        String
  description String  @db.Text
  role        String
  startDate   String  @map("start_date")
  endDate     String? @map("end_date")

  /// Present in projects.json (all 16 rows) but absent from the frontend Project interface.
  type      String?
  /// Present in projects.json (all 16 rows) but absent from the frontend Project interface.
  company   String?
  /// Present in projects.json (6/16) but absent from the frontend Project interface.
  isCurrent Boolean @default(false) @map("is_current")

  isStrategicInitiative Boolean @default(false) @map("is_strategic_initiative")

  /// Declared by the frontend interface and rendered conditionally, but absent from all
  /// 16 current records. Kept nullable rather than dropped.
  imageUrl  String? @map("image_url")
  githubUrl String? @map("github_url")
  liveUrl   String? @map("live_url")

  highlights   ProjectHighlight[]
  technologies ProjectTechnology[]

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("project")
}

model ProjectHighlight {
  id String @id @default(cuid())

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String @db.Text
  sortOrder   Int    @map("sort_order")

  @@index([projectId, sortOrder])
  @@map("proj_highlight")
}

/// Junction: project <-> technology (many-to-many).
model ProjectTechnology {
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  technologyId String     @map("technology_id")
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  sortOrder Int @map("sort_order")

  @@id([projectId, technologyId])
  @@index([projectId, sortOrder])
  @@index([technologyId])
  @@map("proj_technology")
}

// ---------------------------------------------------------------------------
// Technology - reusable across experiences and projects
// ---------------------------------------------------------------------------

/// Reusable within one tenant, across that tenant's experiences and projects.
///
/// Deliberately NOT shared between tenants: a global table would let one tenant rename or
/// delete a technology another tenant's records point at, and would expose every tenant's
/// stack through the list endpoint. The cost is one "Angular" row per tenant, which is the
/// right trade for isolation.
model Technology {
  id String @id @default(cuid())

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Display name, preserving the casing of its first occurrence in the source data.
  name String
  /// Normalised matching key (lower-cased, punctuation collapsed) so "Node.js" and "NodeJS"
  /// cannot split into two rows. This is what the seed and the attach endpoints upsert on.
  slug String

  experiences ExperienceTechnology[]
  projects    ProjectTechnology[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, slug])
  @@unique([personId, name])
  @@index([personId])
  @@map("technology")
}

// ---------------------------------------------------------------------------
// Achievement
// ---------------------------------------------------------------------------

model Achievement {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  title        String
  description  String              @db.Text
  date         String
  category     AchievementCategory
  organization String?
  icon         String?
  articleUrl   String?             @map("article_url")

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("achievement")
}

// ---------------------------------------------------------------------------
// Course
// ---------------------------------------------------------------------------

model Course {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  title          String
  provider       String
  completionDate String  @map("completion_date")
  /// Free text mixing degree level (Diploma, Bachelor's Degree) with difficulty
  /// (Beginner, Intermediate). Deliberately not an enum - see MIGRATION-MAPPING §5.8.
  level          String?
  description    String? @db.Text
  duration       String?
  instructor     String?
  courseUrl      String? @map("course_url")
  /// Declared by the frontend interface, absent from all 27 records.
  certificateUrl String? @map("certificate_url")
  /// Present in courses.json (3/27), absent from the frontend interface.
  startDate      String? @map("start_date")
  /// Present in courses.json (2/27), absent from the frontend interface.
  grade          String?

  skills CourseSkill[]

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("course")
}

/// Course topics. Deliberately NOT joined to Technology: 147 references across 114 distinct
/// values that are mostly subjects ("Instructional Design"), not technologies.
model CourseSkill {
  id String @id @default(cuid())

  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int    @map("sort_order")

  @@index([courseId, sortOrder])
  @@map("course_skill")
}

// ---------------------------------------------------------------------------
// Timeline
// ---------------------------------------------------------------------------

model TimelineEvent {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  date        String
  title       String
  subtitle    String?
  description String            @db.Text
  type        TimelineEventType
  icon        String?

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("timeline_event")
}

// ---------------------------------------------------------------------------
// Management role - a separate concept from Experience, never merged with it
// ---------------------------------------------------------------------------

model ManagementRole {
  id       String @id @default(cuid())
  legacyId String @map("legacy_id")

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  level        ManagementLevel
  title        String
  organization String
  startDate    String          @map("start_date")
  endDate      String?         @map("end_date")
  isCurrent    Boolean         @map("is_current")
  description  String          @db.Text
  /// Declared by the frontend interface, absent from all 3 records.
  teamSize     Int?            @map("team_size")

  keyResponsibilities ManagementResponsibilityItem[]
  achievements        ManagementAchievement[]

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, legacyId])
  @@index([personId, sortOrder])
  @@map("mgmt_role")
}

model ManagementResponsibilityItem {
  id String @id @default(cuid())

  managementRoleId String         @map("mgmt_role_id")
  managementRole   ManagementRole @relation(fields: [managementRoleId], references: [id], onDelete: Cascade)

  description String @db.Text
  sortOrder   Int    @map("sort_order")

  @@index([managementRoleId, sortOrder])
  @@map("mgmt_responsibility")
}

model ManagementAchievement {
  id String @id @default(cuid())

  managementRoleId String         @map("mgmt_role_id")
  managementRole   ManagementRole @relation(fields: [managementRoleId], references: [id], onDelete: Cascade)

  description String @db.Text
  sortOrder   Int    @map("sort_order")

  @@index([managementRoleId, sortOrder])
  @@map("mgmt_achievement")
}

// ---------------------------------------------------------------------------
// Skills - addition, see MIGRATION-MAPPING §5.3
// ---------------------------------------------------------------------------

model SkillCategory {
  id String @id @default(cuid())

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  name String

  skills Skill[]

  sortOrder   Int     @map("sort_order")
  isPublished Boolean @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personId, name])
  @@index([personId, sortOrder])
  @@map("skill_category")
}

model Skill {
  id String @id @default(cuid())

  categoryId String        @map("category_id")
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name              String
  /// 0-9. 0 means "unranked" and the UI renders it as a grey no-rank tag - it is NOT the
  /// same as level 1, so it must never be coerced.
  level             Int
  /// Year the skill was first used. Present on all 117 source records.
  since             Int?
  /// Declared by the frontend Skill interface, absent from all 117 records. The frontend
  /// resolves icons at runtime via SkillIconService.
  icon              String?
  yearsOfExperience Int?    @map("years_of_experience")
  endorsements      Int?

  sortOrder Int @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, name])
  @@index([categoryId, sortOrder])
  @@map("skill")
}

// ---------------------------------------------------------------------------
// CV export - a saved configuration for generating an ATS-optimized PDF/DOCX from the
// profile domain above. See docs/SAAS-ARCHITECTURE.md and src/cv/.
// ---------------------------------------------------------------------------

model CvVersion {
  id String @id @default(cuid())

  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// The version's own label ("General CV", "AI Engineer CV") - distinct from cvTitle below.
  name String

  /// Exactly one true per person - enforced by a partial unique index in the migration
  /// (schema.prisma's DSL cannot express a WHERE-qualified unique index).
  isDefault Boolean @default(false) @map("is_default")

  /// Validated against CV_TEMPLATES in cv-template-registry.ts, not a DB enum - see
  /// design-registry.ts for the same pattern applied to the public site's design system.
  templateId String @default("ATS_CLASSIC") @map("template_id")

  /// Overrides Person.title/summary for this CV only. Null falls back to the live Person row.
  cvTitle   String? @map("cv_title")
  cvSummary String? @map("cv_summary") @db.Text

  includePhone      Boolean @default(true) @map("include_phone")
  includeEmail      Boolean @default(true) @map("include_email")
  includeLinkedin   Boolean @default(true) @map("include_linkedin")
  includeGithub     Boolean @default(true) @map("include_github")
  includePortfolio  Boolean @default(true) @map("include_portfolio")
  includeManagement Boolean @default(true) @map("include_management")

  /// Ordered [{key, enabled}] for CV_SECTION_KEYS (cv-section-registry.ts) - array order IS
  /// section render order. Json rather than a child table like ClientSection: this is edited
  /// as one whole-form save from the CV Builder, not frequent single-toggle writes, so the
  /// read-modify-write cost that justified extracting ClientSection into its own table
  /// doesn't apply here.
  sectionConfig Json @default("[]") @map("section_config")

  /// Experience/Project ids excluded from THIS CV version only, independent of their public
  /// isPublished flag - both can be true at once. Ids no longer belonging to this person are
  /// ignored defensively at build time, never erroring.
  excludedExperienceIds Json @default("[]") @map("excluded_experience_ids")
  excludedProjectIds    Json @default("[]") @map("excluded_project_ids")

  /// Optional explicit ordering override. Null (the only value Phase 1's UI ever writes)
  /// falls back to newest-first by parsed startDate.
  experienceOrder Json? @map("experience_order")
  projectOrder    Json? @map("project_order")

  /// Phase 2 (AI / job-description matching) fields. Nullable and deliberately unused by
  /// every Phase 1 DTO/service, so that feature can land later without a migration.
  targetRole     String? @map("target_role")
  jobDescription String? @map("job_description") @db.Text
  targetCompany  String? @map("target_company")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId])
  @@map("cv_version")
}
