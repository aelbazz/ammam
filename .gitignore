# Dependencies
/node_modules

# Build output
/dist
*.tsbuildinfo

# Tests
/coverage
/.nyc_output

# Environment - NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# Prisma
prisma/*.db
prisma/*.db-journal

# Runtime-uploaded files (StorageService/LocalStorageService) - never committed. The default
# avatar under public/assets/ is a static, committed asset and is not covered by this.
/public/uploads/

# Supabase CLI - Prisma Migrate owns the schema; the CLI's own migration
# directory must never become a competing source of truth. See docs/DEPLOYMENT.md.
supabase/.temp/
supabase/.branches/
supabase/migrations/
