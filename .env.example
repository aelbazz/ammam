# ---------------------------------------------------------------------------
# Copy to .env for local development.  NEVER commit a real .env.
# Every variable is validated at startup (src/config/env.validation.ts) - the
# process refuses to boot rather than failing on the first request.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database
#
# Prisma needs TWO urls when the database sits behind a connection pooler:
#   DATABASE_URL  - runtime queries (pooled)
#   DIRECT_URL    - migrations (direct session; PgBouncer's transaction mode
#                   cannot run the advisory locks Prisma Migrate needs)
#
# --- Local Postgres (matches docker-compose.yml) ---
# There is no pooler locally, so both point at the same place.
DATABASE_URL=postgresql://profile:profile@localhost:5432/profile?schema=public
DIRECT_URL=postgresql://profile:profile@localhost:5432/profile?schema=public

# --- Supabase (project qvyhsdvlgkfzwsjotiwp) ---
# Get the password from: Supabase dashboard -> Project Settings -> Database ->
# Database password (Reset if you no longer have it). Put it in YOUR .env only.
#
# DIRECT_URL - direct connection, port 5432. This is the string the dashboard
# shows under "Connection string -> URI". Prisma Migrate must use this.
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.qvyhsdvlgkfzwsjotiwp.supabase.co:5432/postgres?sslmode=require
#
# DATABASE_URL - runtime queries. Prefer the TRANSACTION pooler (port 6543) so a
# restarting container cannot exhaust the direct-connection limit. Copy the exact
# host from the dashboard's "Connection pooling" section and fill in [REGION]:
# DATABASE_URL=postgresql://postgres.qvyhsdvlgkfzwsjotiwp:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#
# Simpler alternative: point DATABASE_URL at the same direct string as DIRECT_URL.
# That works, but direct connections are capped low and are IPv6-only on newer
# Supabase projects unless the IPv4 add-on is enabled - if your host is IPv4-only,
# the pooler is not optional.
#
# NOTE: the publishable key (sb_publishable_...) is NOT a database credential.
# It authenticates browser clients against Supabase's PostgREST/Auth APIs, which
# this backend does not use - it talks to Postgres directly via Prisma. It has no
# place in any variable here.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Signing secret for admin JWTs. MUST be >= 32 characters - validation enforces it.
# Generate one with:  openssl rand -base64 48
# This is the API's own secret and has nothing to do with Supabase's JWT secret.
JWT_SECRET=replace-me-with-at-least-32-random-characters-abcdef
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS - comma-separated origins. Wildcards are rejected in production.
# Use the ORIGIN only, with no path: the GitHub Pages site at
# https://aelbazz.github.io/profile/ has origin https://aelbazz.github.io
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:4100,http://localhost:4200,https://aelbazz.github.io

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Stricter budget for POST /auth/login specifically
AUTH_THROTTLE_LIMIT=5

# Swagger. Defaults to on outside production, off in production.
# SWAGGER_ENABLED=false

# Every profile is a tenant. This is the one served by /api/v1/public/profile when no
# slug is given; each tenant is always addressable at /api/v1/public/profile/<slug>.
# DEFAULT_PROFILE_SLUG=default

# ---------------------------------------------------------------------------
# Seed-only. Used once by `yarn db:seed` to create the initial admin account.
# In production supply these as deployment secrets - never commit them, and
# never reuse the example password.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding
